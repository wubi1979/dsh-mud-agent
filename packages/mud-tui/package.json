{
  "name": "@deepseek-ai/dsh-mud-tui",
  "description": "Terminal shell for the MUD player core: pi-tui alternate-screen two-column layout (tabbed game/chat main area + input + status bar on the left, decisions/world state/version on the right), consuming the ctx.mud service",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/mud-tui"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./invariant": {
      "types": "./dist/invariant.d.ts",
      "default": "./dist/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "pnpm exec vitest run tests"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^0.84.2",
    "@xterm/headless": "^6.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-invariants": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-mud-core": "workspace:^",
    "@deepseek-ai/dsh-session": "^0.1.2-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-invariants": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-mud-core": "workspace:^",
    "@deepseek-ai/dsh-session": "^0.1.2-alpha.2",
    "vitest": "^4.1.8"
  }
}