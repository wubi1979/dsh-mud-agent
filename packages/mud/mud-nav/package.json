{
  "name": "mud-nav",
  "description": "MUD 导航特性 Provider（T28 拆包）：NavGraph 图 · route 路由解析 · blocker 阻塞连击 · stamina 精力闸纯层 · NavService 有状态服务 · 项目内 JSON 文件持久化。内部依赖，零宿主依赖（D9 矩阵）。",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./graph": {
      "types": "./lib/graph.d.ts",
      "default": "./lib/graph.js"
    },
    "./route": {
      "types": "./lib/route.d.ts",
      "default": "./lib/route.js"
    },
    "./blocker": {
      "types": "./lib/blocker.d.ts",
      "default": "./lib/blocker.js"
    },
    "./stamina": {
      "types": "./lib/stamina.d.ts",
      "default": "./lib/stamina.js"
    },
    "./service": {
      "types": "./lib/service.d.ts",
      "default": "./lib/service.js"
    },
    "./store": {
      "types": "./lib/store.d.ts",
      "default": "./lib/store.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "test": "pnpm exec vitest run tests",
    "typecheck": "tsc -p tsconfig.test.json"
  }
}
