{
  "name": "tool-mud",
  "description": "MUD 组合根 + 工具面 Consumer（T28 拆包）：cordis 插件入口（宿主接线：事件、remote.mud 命名空间、storage 域、凭据、投递）· mud_* 四工具与 mud_workflow_* 注册 · mud-player preset 行 · typert 工件（./typert + ./remote）。唯一 bundle 面：装配注册全部 mud-* 包。",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-goal": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-generator": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "workspace:*",
    "mud": "workspace:^",
    "mud-commands": "workspace:^",
    "mud-combat": "workspace:^",
    "mud-flows": "workspace:^",
    "mud-link": "workspace:^",
    "mud-nav": "workspace:^",
    "mud-sense": "workspace:^",
    "mud-workflow": "workspace:^"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "gen:typert": "node ../../scripts/gen-typert.mjs",
    "test": "pnpm exec vitest run tests",
    "typecheck": "tsc -p tsconfig.test.json"
  }
}
