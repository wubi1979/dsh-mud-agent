{
  "name": "@deepseek-ai/dsh-typert-protocol",
  "description": "镜像自 deepseek-harness packages/typert/protocol (v0.1.5-rc.2)。typert 生成器要求协议包真实存在于本工作区 packages/ 内 (realPath 判定, 链接/装挂会被还原成仓库外路径而失效); 上游升版时重新拷贝 src/ 并同步 version。",
  "version": "0.1.5-rc.2",
  "type": "module",
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/types/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  }
}
